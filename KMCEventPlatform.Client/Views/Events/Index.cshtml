@model KMCEventPlatform.Client.Models.EventSearchViewModel

@{
    ViewData["Title"] = "City Events";
}

<div class="text-center mb-4">
    <h1 class="display-5 fw-bold">
        Kandy City Events
    </h1>

    <p class="lead">
        Search and discover events taking place in Kandy.
    </p>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">
        @TempData["SuccessMessage"]
    </div>
}

@if (ViewBag.ErrorMessage != null)
{
    <div class="alert alert-danger">
        @ViewBag.ErrorMessage
    </div>
}

<div class="card shadow-sm mb-5">
    <div class="card-body">
        <h4 class="mb-3">Search Events</h4>

        <form asp-controller="Events"
              asp-action="Index"
              method="get">

            <div class="row">
                <div class="col-md-6 col-lg-4 mb-3">
                    <label asp-for="Title"
                           class="form-label">
                        Event title
                    </label>

                    <input asp-for="Title"
                           class="form-control"
                           placeholder="Search by title" />
                </div>

                <div class="col-md-6 col-lg-4 mb-3">
                    <label asp-for="Date"
                           class="form-label">
                        Event date
                    </label>

                    <input asp-for="Date"
                           type="date"
                           class="form-control" />
                </div>

                <div class="col-md-6 col-lg-4 mb-3">
                    <label asp-for="EventTypeId"
                           class="form-label">
                        Event type
                    </label>

                    <select asp-for="EventTypeId"
                            class="form-select">

                        <option value="">
                            All event types
                        </option>

                        @foreach (var eventType
                            in Model.EventTypes)
                        {
                            <option value="@eventType.EventTypeId">
                                @eventType.TypeName
                            </option>
                        }
                    </select>
                </div>

                <div class="col-md-6 col-lg-4 mb-3">
                    <label asp-for="Venue"
                           class="form-label">
                        Venue
                    </label>

                    <input asp-for="Venue"
                           class="form-control"
                           placeholder="Search by venue" />
                </div>

                <div class="col-md-6 col-lg-4 mb-3">
                    <label asp-for="Status"
                           class="form-label">
                        Status
                    </label>

                    <select asp-for="Status"
                            class="form-select">
                        <option value="">
                            All statuses
                        </option>
                        <option value="Upcoming">
                            Upcoming
                        </option>
                        <option value="Cancelled">
                            Cancelled
                        </option>
                        <option value="Completed">
                            Completed
                        </option>
                    </select>
                </div>
            </div>

            <button type="submit"
                    class="btn btn-primary">
                Search
            </button>

            <a asp-controller="Events"
               asp-action="Index"
               class="btn btn-outline-secondary">
                Clear
            </a>
        </form>
    </div>
</div>

<div class="d-flex justify-content-between
            align-items-center mb-3">
    <h3>Available Events</h3>

    <span class="text-muted">
        @Model.Events.Count event(s) found
    </span>
</div>

@if (!Model.Events.Any())
{
    <div class="alert alert-info">
        No matching events were found.
    </div>
}
else
{
    <div class="row">
        @foreach (var cityEvent in Model.Events)
        {
            <div class="col-md-6 col-lg-4 mb-4">
                <div class="card h-100 shadow-sm">
                    <div class="card-body">
                        <span class="badge bg-primary mb-2">
                            @cityEvent.EventTypeName
                        </span>

                        <h4 class="card-title">
                            @cityEvent.Title
                        </h4>

                        <p class="card-text">
                            @{
                                string description =
                                    cityEvent.Description.Length > 120
                                    ? cityEvent.Description[..120] + "..."
                                    : cityEvent.Description;
                            }

                            @description
                        </p>

                        <p class="mb-1">
                            <strong>Date:</strong>
                            @cityEvent.EventDate.ToString("dd MMMM yyyy")
                        </p>

                        <p class="mb-1">
                            <strong>Time:</strong>
                            @cityEvent.StartTime.ToString(@"hh\:mm")
                            -
                            @cityEvent.EndTime.ToString(@"hh\:mm")
                        </p>

                        <p class="mb-1">
                            <strong>Venue:</strong>
                            @cityEvent.Venue
                        </p>

                        <p class="mb-1">
                            <strong>Status:</strong>
                            @cityEvent.Status
                        </p>

                        <p>
                            <strong>Available places:</strong>
                            @(cityEvent.MaximumParticipants -
                              cityEvent.RegisteredParticipants)
                        </p>
                    </div>

                    <div class="card-footer bg-white">
                        <a asp-controller="Events"
                           asp-action="Details"
                           asp-route-id="@cityEvent.EventId"
                           class="btn btn-outline-primary">
                            View Details
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
}