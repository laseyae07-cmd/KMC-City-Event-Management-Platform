@model KMCEventPlatform.Client.Models.OrganizerEventFormViewModel

@{
    ViewData["Title"] = "Edit Event";
}

<h1 class="mb-4">Edit Event</h1>

<div class="card shadow-sm">
    <div class="card-body p-4">
        <form asp-action="Edit"
              asp-route-id="@Model.EventId"
              method="post">

            <input asp-for="EventId" type="hidden" />

            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3">
            </div>

            <div class="mb-3">
                <label asp-for="Title"
                       class="form-label">
                </label>

                <input asp-for="Title"
                       class="form-control" />
            </div>

            <div class="mb-3">
                <label asp-for="Description"
                       class="form-label">
                </label>

                <textarea asp-for="Description"
                          class="form-control"
                          rows="5">
                </textarea>
            </div>

            <div class="row">
                <div class="col-md-4 mb-3">
                    <label asp-for="EventDate"
                           class="form-label">
                    </label>

                    <input asp-for="EventDate"
                           type="date"
                           min="@DateTime.Today.ToString("yyyy-MM-dd")"
                           class="form-control" />
                </div>

                <div class="col-md-4 mb-3">
                    <label asp-for="StartTime"
                           class="form-label">
                    </label>

                    <input asp-for="StartTime"
                           type="time"
                           class="form-control" />
                </div>

                <div class="col-md-4 mb-3">
                    <label asp-for="EndTime"
                           class="form-label">
                    </label>

                    <input asp-for="EndTime"
                           type="time"
                           class="form-control" />
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="Venue"
                       class="form-label">
                </label>

                <input asp-for="Venue"
                       class="form-control" />
            </div>

            <div class="row">
                <div class="col-md-4 mb-3">
                    <label asp-for="MaximumParticipants"
                           class="form-label">
                    </label>

                    <input asp-for="MaximumParticipants"
                           class="form-control" />
                </div>

                <div class="col-md-4 mb-3">
                    <label asp-for="EventTypeId"
                           class="form-label">
                    </label>

                    <select asp-for="EventTypeId"
                            class="form-select">
                        @foreach (var eventType
                            in Model.EventTypes)
                        {
                            <option value="@eventType.EventTypeId">
                                @eventType.TypeName
                            </option>
                        }
                    </select>
                </div>

                <div class="col-md-4 mb-3">
                    <label asp-for="Status"
                           class="form-label">
                    </label>

                    <select asp-for="Status"
                            class="form-select">
                        <option value="Upcoming">
                            Upcoming
                        </option>

                        <option value="Cancelled">
                            Cancelled
                        </option>

                        <option value="Completed">
                            Completed
                        </option>
                    </select>
                </div>
            </div>

            <button type="submit"
                    class="btn btn-primary">
                Save Changes
            </button>

            <a asp-action="Dashboard"
               class="btn btn-secondary">
                Cancel
            </a>
        </form>
    </div>
</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}